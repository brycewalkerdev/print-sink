<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(PrintSinkWindowsTargetFramework)</TargetFramework>
    <RootNamespace>PrintSink.Tasks</RootNamespace>
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU' Or '$(Platform)' == 'Any CPU'">x64</Platform>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <CsWinRTComponent>true</CsWinRTComponent>
    <CsWinRTWindowsMetadata>10.0.28000.0</CsWinRTWindowsMetadata>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      CsWinRT generates public ABI marshalling code for activatable classes during compilation. Authored
      XML comments remain enforced by architecture tests; csc XML output is disabled here so generated
      ABI sources are not treated as project-authored documentation surface.
    -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT" />
    <ProjectReference Include="..\PrintSink.Core\PrintSink.Core.csproj" />
    <ProjectReference Include="..\PrintSink.Xps.Projections\PrintSink.Xps.Projections.csproj" />
  </ItemGroup>
</Project>
