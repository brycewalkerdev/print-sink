<Project Sdk="Microsoft.NET.Sdk">

    <!-- <snippet:template-shape> -->
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>$(PrintSinkWindowsTargetFramework)</TargetFramework>
        <RootNamespace>PrintSink.App</RootNamespace>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <!--
            x64 first so an unqualified `dotnet build` / F5 picks the right default on the
            majority of dev machines. ARM64 second for Snapdragon X.
        -->
        <Platforms>x64;ARM64</Platforms>
        <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU' Or '$(Platform)' == 'Any CPU'">x64</Platform>
        <PrintSinkXpsPlatform>$(Platform)</PrintSinkXpsPlatform>
        <UseWinUI>true</UseWinUI>
        <WindowsPackageType>MSIX</WindowsPackageType>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!--
            WindowsAppSDKSelfContained bundles the Windows App SDK runtime alongside the
            published exe so the app:
              (a) runs from any folder without a separate Windows App Runtime install, and
              (b) survives `dotnet watch run` hot reload (used by the Reactor Visual Studio
                  embedded-preview extension — spec 056). Incremental rebuilds otherwise
                  double-count transitive Microsoft.WindowsAppSDK.* references and trip
                  Microsoft.WindowsAppSDK.ComponentReference.targets' strict version check
                  ("version 2.0.20;2.0.20 was referenced"). Self-contained bundling
                  sidesteps that check.
            Tradeoff: ~30 MB extra in the publish output. To ship framework-dependent
            (smaller publish, requires the user to install Microsoft.WindowsAppRuntime
            separately) flip this to false and ensure your install instructions tell users
            to install the runtime first.
        -->
        <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
        <WindowsAppSdkUndockedRegFreeWinRTInitialize>false</WindowsAppSdkUndockedRegFreeWinRTInitialize>
        <TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
        <SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
        <NoWarn>$(NoWarn);CS8305</NoWarn>
        <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
        <RuntimeIdentifier Condition="'$(Configuration)' == 'Release' And '$(RuntimeIdentifier)' == '' And '$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
        <RuntimeIdentifier Condition="'$(Configuration)' == 'Release' And '$(RuntimeIdentifier)' == '' And '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
        <WinUISDKReferences>false</WinUISDKReferences>
        <EnableMsixTooling>true</EnableMsixTooling>
        <CsWinRTWindowsMetadata>10.0.28000.0</CsWinRTWindowsMetadata>
        <CsWinRTPrivateProjection>true</CsWinRTPrivateProjection>
        <CsWinRTIncludesPrivate>
            Windows.Devices.Printers.VirtualPrinterInstallationParameters;
            Windows.Devices.Printers.VirtualPrinterInstallationResult;
            Windows.Devices.Printers.VirtualPrinterInstallationStatus;
            Windows.Devices.Printers.VirtualPrinterPreferredInputFormat;
            Windows.Devices.Printers.VirtualPrinterManager;
            Windows.Devices.Printers.VirtualPrinterSupportedFormat;
            Windows.Devices.Printers.IVirtualPrinterInstallationParameters;
            Windows.Devices.Printers.IVirtualPrinterInstallationResult;
            Windows.Devices.Printers.IVirtualPrinterManagerStatics;
            Windows.Devices.Printers.IVirtualPrinterSupportedFormat;
            Windows.Devices.Printers.IVirtualPrinterSupportedFormatFactory;
            Windows.Devices.Printers.IppAttributeConverter;
            Windows.Devices.Printers.IppAttributeGroupKind;
            Windows.Devices.Printers.IIppAttributeConverterStatics;
            Windows.Devices.Printers.IPdlPassthroughProvider2
        </CsWinRTIncludesPrivate>
        <!--
            Default unqualified CLI runs to x64 through the Platform property above. Keeping all
            generated WinUI sources under obj\<Platform>\... avoids Visual Studio design-time builds
            picking up a second obj\Debug\<TargetFramework>\<RuntimeIdentifier> generated-source tree.
        -->
    </PropertyGroup>
    <!-- </snippet:template-shape> -->

    <ItemGroup>
        <Content Include="Assets\SplashScreen.scale-200.png" />
        <Content Include="Assets\LockScreenLogo.scale-200.png" />
        <Content Include="Assets\Square150x150Logo.scale-200.png" />
        <Content Include="Assets\Square44x44Logo.scale-200.png" />
        <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
        <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
        <Content Include="Assets\StoreLogo.png" />
        <Content Include="Assets\AppIcon.ico" />
        <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="Config\*.xml">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <Manifest Include="$(ApplicationManifest)" />
    </ItemGroup>

    <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)' != 'true' and '$(EnableMsixTooling)' == 'true'">
        <ProjectCapability Include="Msix" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" />
        <PackageReference Include="Microsoft.Windows.CsWinRT" />
        <PackageReference Include="Microsoft.WindowsAppSDK" />
        <PackageReference Include="Microsoft.UI.Reactor" />
        <ProjectReference Include="..\PrintSink.Core\PrintSink.Core.csproj" />
        <ProjectReference Include="..\PrintSink.Tasks\PrintSink.Tasks.csproj" ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\PrintSink.Xps.Projections\PrintSink.Xps.Projections.csproj" ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\PrintSink.Xps\PrintSink.Xps.vcxproj" ReferenceOutputAssembly="false" Condition="'$(MSBuildRuntimeType)' != 'Core'" />
    </ItemGroup>

    <ItemGroup>
        <AppxPackagePayload Include="..\PrintSink.Tasks\bin\$(Platform)\$(Configuration)\$(TargetFramework)\PrintSink.Tasks.winmd">
            <TargetPath>PrintSink.Tasks.winmd</TargetPath>
        </AppxPackagePayload>
        <AppxPackagePayload Include="..\PrintSink.Tasks\bin\$(Platform)\$(Configuration)\$(TargetFramework)\PrintSink.Tasks.deps.json">
            <TargetPath>PrintSink.Tasks.deps.json</TargetPath>
        </AppxPackagePayload>
        <AppxPackagePayload Include="..\PrintSink.Xps\$(PrintSinkXpsPlatform)\$(Configuration)\PrintSink.Xps.dll">
            <TargetPath>PrintSink.Xps.dll</TargetPath>
        </AppxPackagePayload>
        <AppxPackagePayload Include="..\PrintSink.Xps\$(PrintSinkXpsPlatform)\$(Configuration)\PrintSink.Xps.winmd">
            <TargetPath>PrintSink.Xps.winmd</TargetPath>
        </AppxPackagePayload>
        <AppxPackagePayload Include="..\PrintSink.Xps\PrintSink.Xps.dll.manifest">
            <TargetPath>PrintSink.Xps.dll.manifest</TargetPath>
        </AppxPackagePayload>
        <AppxPackagePayload Include="..\PrintSink.Xps.Projections\bin\$(Platform)\$(Configuration)\$(TargetFramework)\PrintSink.Xps.Projections.dll">
            <TargetPath>PrintSink.Xps.Projections.dll</TargetPath>
        </AppxPackagePayload>
    </ItemGroup>

    <Target Name="IncludePrintSinkTasksActivationAssets" AfterTargets="Build">
        <ItemGroup>
            <_PrintSinkTasksActivationAsset Include="..\PrintSink.Tasks\bin\$(Platform)\$(Configuration)\$(TargetFramework)\PrintSink.Tasks.dll" />
            <_PrintSinkTasksActivationAsset Include="..\PrintSink.Tasks\bin\$(Platform)\$(Configuration)\$(TargetFramework)\PrintSink.Tasks.deps.json" />
            <_PrintSinkTasksActivationAsset Include="..\PrintSink.Tasks\bin\$(Platform)\$(Configuration)\$(TargetFramework)\PrintSink.Tasks.winmd" />
            <_PrintSinkTasksActivationAsset Include="..\PrintSink.Tasks\bin\$(Platform)\$(Configuration)\$(TargetFramework)\WinRT.Host.dll" />
            <_PrintSinkTasksActivationAsset Include="..\PrintSink.Tasks\bin\$(Platform)\$(Configuration)\$(TargetFramework)\WinRT.Host.dll.mui" />
            <_PrintSinkTasksActivationAsset Include="..\PrintSink.Tasks\bin\$(Platform)\$(Configuration)\$(TargetFramework)\WinRT.Host.runtimeconfig.json" />
            <_PrintSinkTasksActivationAsset Include="..\PrintSink.Tasks\bin\$(Platform)\$(Configuration)\$(TargetFramework)\WinRT.Host.Shim.dll" />
            <_PrintSinkTasksActivationAsset Include="..\PrintSink.Tasks\bin\$(Platform)\$(Configuration)\$(TargetFramework)\WinRT.Runtime.dll" />
            <_PrintSinkTasksActivationAsset Include="..\PrintSink.Xps.Projections\bin\$(Platform)\$(Configuration)\$(TargetFramework)\PrintSink.Xps.Projections.dll" />
        </ItemGroup>
        <Copy
            SourceFiles="@(_PrintSinkTasksActivationAsset)"
            DestinationFolder="$(OutputPath)"
            SkipUnchangedFiles="true"
            Condition="Exists('%(_PrintSinkTasksActivationAsset.Identity)')" />
        <Copy
            SourceFiles="@(_PrintSinkTasksActivationAsset)"
            DestinationFolder="$(OutputPath)AppX"
            SkipUnchangedFiles="true"
            Condition="Exists('$(OutputPath)AppX') And Exists('%(_PrintSinkTasksActivationAsset.Identity)')" />
    </Target>

    <Target Name="IncludePrintSinkXpsAssets" AfterTargets="Build">
        <ItemGroup>
            <_PrintSinkXpsAsset Include="..\PrintSink.Xps\$(PrintSinkXpsPlatform)\$(Configuration)\PrintSink.Xps.dll" />
            <_PrintSinkXpsAsset Include="..\PrintSink.Xps\$(PrintSinkXpsPlatform)\$(Configuration)\PrintSink.Xps.winmd" />
            <_PrintSinkXpsAsset Include="..\PrintSink.Xps\PrintSink.Xps.dll.manifest" />
        </ItemGroup>
        <Copy
            SourceFiles="@(_PrintSinkXpsAsset)"
            DestinationFolder="$(OutputPath)"
            SkipUnchangedFiles="true"
            Condition="Exists('%(_PrintSinkXpsAsset.Identity)')" />
        <Copy
            SourceFiles="@(_PrintSinkXpsAsset)"
            DestinationFolder="$(OutputPath)AppX"
            SkipUnchangedFiles="true"
            Condition="Exists('$(OutputPath)AppX') And Exists('%(_PrintSinkXpsAsset.Identity)')" />
    </Target>

    <Target
        Name="PatchPrintSinkAppExecutionAliasManifest"
        BeforeTargets="_ValidateAppxManifest;_GenerateAppxPackageRecipe;_GenerateAppxPackageFile"
        Condition="'$(AppxPackage)' == 'true' And Exists('$(FinalAppxManifestName)')">
        <XmlPoke
            XmlInputPath="$(FinalAppxManifestName)"
            Query="//*[local-name()='Extension' and @Category='windows.appExecutionAlias']/@Executable"
            Value="$(TargetName).exe" />
    </Target>

    <!--
        Debug-only: enable the Reactor devtools surface so the *devtools* flag
        (from Properties/launchSettings.json's default F5 args) lights up the
        devtools menu, and so the Visual Studio embedded-preview extension's
        embed-host activation (which requires devtools support) succeeds.
        Release / Publish builds drop both the package and the host-config
        switch so the trim / AOT analyzers stay happy (see
        docs/guide/packaging.md, section "Keep Reactor.DevtoolsSupport out of
        retail"). To enable devtools in Release as well, move these into the
        unconditioned ItemGroup above.
    -->
    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <PackageReference Include="Microsoft.UI.Reactor.Devtools" />
        <RuntimeHostConfigurationOption Include="Reactor.DevtoolsSupport" Value="true" Trim="true" />
    </ItemGroup>

    <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)' != 'true' and '$(EnableMsixTooling)' == 'true'">
        <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
    </PropertyGroup>

    <PropertyGroup>
        <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
        <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
        <PublishTrimmed>False</PublishTrimmed>
        <AppxAutoIncrementPackageRevision Condition="'$(Configuration)' == 'Release'">True</AppxAutoIncrementPackageRevision>
    </PropertyGroup>

</Project>
